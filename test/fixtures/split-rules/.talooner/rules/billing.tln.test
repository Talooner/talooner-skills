test "A billing change waits for a human" {
  given {
    record 1 type "pr"
    attr 1 "pr.changed_files" ["billing/refund.go"]

    record 2 type "pr"
    attr 2 "pr.changed_files" ["billing/refund.go"]
    attr 2 "review.human.approved" true

    record 3 type "pr"
    attr 3 "pr.changed_files" ["src/authorization/roles.go"]
  }

  when rule "Billing needs review"

  expect {
    flagged 1
    not flagged 2
    not flagged 3
    did 1 block "pr.merge"
    did 1 assign "pr"
  }
}
