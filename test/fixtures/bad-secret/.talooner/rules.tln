define "critical_path" {
  attr "pr.changed_files" contains ".talooner/"
    or attr "pr.changed_files" contains "auth/"
    or attr "pr.changed_files" contains "billing/"
    or attr "pr.changed_files" contains "migrations/"
}

rule "Block PRs with no description" {
  for records where type == "pr"
    and attr "pr.draft" == false
    and attr "pr.has_description" == false
  block "merge"
  do block "pr.merge"
  do comment "pr" "No description. Say what changed and why before requesting review"
  reason "no description"
  priority HIGH
}

rule "Critical path needs review" {
  for records where type == "pr" and is "critical_path"
  do block "pr.merge"
  do assign "pr" attr "user.owner"
  do comment "pr" "Changes a sensitive path; the owner is assigned for review"
  reason "critical path"
  priority HIGH
}

rule "Oversized PR needs human review" {
  for records where type == "pr" and attr "pr.lines_changed" >= 1500
  do block "pr.merge"
  do assign "pr" attr "user.owner"
  do comment "pr" "Very large change; split it or ask for an explicit review"
  reason "oversized"
  priority HIGH
}

rule "CI checks still running" {
  for records where type == "pr" and attr "pr.checks_pending" == true
  do comment "pr" "Waiting for required checks to finish."
  reason "checks pending"
  priority LOW
}

enrich "cdm: how risky is this PR?" {
  for records where type == "pr"
  stale_after 1 hour
  tool "cdm" "decide" {
    state   concat(attr "pr.title", "\n\n", attr "pr.body", "\n\nChanged files:\n", join(attr "pr.changed_files", "\n"))
    choices "low, medium, high"
  }
  update attr "pr.risk" from result.chosen
  update attr "pr.risk_certainty" from result.certainty
}

rule "Confident high risk needs a senior review" {
  for records where type == "pr"
    and attr "pr.risk" == "high"
    and attr "pr.risk_certainty" >= 0.85
  do block "pr.merge"
  do assign "pr" attr "user.owner"
  do comment "pr" "The decision model rates this change high risk"
  priority HIGH
}

enrich "cdm: does the description say why?" {
  for records where type == "pr"
  stale_after 1 hour
  tool "cdm" "decide" {
    state   concat(attr "pr.title", "\n\n", attr "pr.body")
    choices "explains why, says only what, vague"
  }
  update attr "pr.description_kind" from result.chosen
  update attr "pr.description_certainty" from result.certainty
}

rule "Confident vague description gets a comment" {
  for records where type == "pr"
    and attr "pr.description_kind" == "vague"
    and attr "pr.description_certainty" >= 0.85
  do comment "pr" "The description says what changed but not why"
  priority MEDIUM
}

rule "AI review was inconclusive" {
  for records where type == "code_unit" and attr "unit.llm_result" == "unclear"
  do block "pr.merge"
  do assign "pr" attr "user.owner"
  do comment "pr" "The AI review could not decide on a changed unit; a human read is required"
  reason "ai review inconclusive"
  priority MEDIUM
}

rule "AI review failed" {
  for records where type == "code_unit" and attr "unit.llm_result" == "error"
  do block "pr.merge"
  do assign "pr" attr "user.owner"
  do comment "pr" "The AI review failed on a changed unit; a human read is required"
  reason "ai review failed"
  priority MEDIUM
}
